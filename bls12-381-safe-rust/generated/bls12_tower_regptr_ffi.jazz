  out = out__s;
  out[0 : 72] = __rp72_0;
  out__s = out;
  out = out__s;
  return out;
}


fn bls12_pairing(reg ptr u64[72] out, reg const ptr u64[6] p_x, reg const ptr u64[6] p_y, reg const ptr u64[12] q_x, reg const ptr u64[12] q_y) -> reg ptr u64[72] {
  reg u64 __wtmp__;
  reg u64 __mulx_tmp__;
  reg u64 __mv__;
  reg u64 __mlo__;
  reg u64 __shc__;
  reg u64 __ca__;
  reg u64 __cb__;
  inline int __j;
  reg u64 __la0;
  reg u64 __la1;
  reg u64 __la2;
  reg u64 __la3;
  reg u64 __la4;
  stack u64[12] __sg12_0;
  stack u64[72] __sg72_0;
  stack u64[6] __sg6_1;
  stack u64[6] __sg6_2;
  stack u64[12] __sg12_3;
  stack u64[12] __sg12_4;
  stack u64[72] __sg72_1;
  stack u64[12] __sg12_2;
  reg ptr u64[12] __rp12_0;
  reg const ptr u64[12] __rq12_0;
  reg ptr u64[72] __rp72_0;
  reg const ptr u64[72] __rq72_0;
  reg ptr u64[6] __rp6_1;
  reg const ptr u64[6] __rq6_1;
  reg ptr u64[6] __rp6_2;
  reg const ptr u64[6] __rq6_2;
  reg ptr u64[12] __rp12_3;
  reg const ptr u64[12] __rq12_3;
  reg ptr u64[12] __rp12_4;
  reg const ptr u64[12] __rq12_4;
  reg ptr u64[72] __rp72_1;
  reg const ptr u64[72] __rq72_1;
  reg ptr u64[12] __rp12_2;
  reg const ptr u64[12] __rq12_2;
  stack ptr u64[72] out__s;
  stack ptr u64[6] p_x__s;
  stack ptr u64[6] p_y__s;
  stack ptr u64[12] q_x__s;
  stack ptr u64[12] q_y__s;
  out__s = out;
  p_x__s = p_x;
  p_y__s = p_y;
  q_x__s = q_x;
  q_y__s = q_y;
  stack u64[72] tmp;
  stack u64[12] gamma1_p2;
  stack u64[12] gamma2_p2;
  stack u64[12] w_frob_p2_c1;
  gamma1_p2 = bls12_load_gamma1_p2(gamma1_p2);
  gamma2_p2 = bls12_load_gamma2_p2(gamma2_p2);
  w_frob_p2_c1 = bls12_load_w_frob_p2_c1(w_frob_p2_c1);
  p_x = p_x__s;
  __rq6_1 = p_x[0 : 6];
  p_y = p_y__s;
  __rq6_2 = p_y[0 : 6];
  q_x = q_x__s;
  __rq12_3 = q_x[0 : 12];
  q_y = q_y__s;
  __rq12_4 = q_y[0 : 12];
  tmp = bls12_miller_loop(tmp, __rq6_1, __rq6_2, __rq12_3, __rq12_4);
  out = out__s;
  __rp72_0 = out[0 : 72];
  __rp72_0 = bls12_final_exp(__rp72_0, tmp, gamma1_p2, gamma2_p2, w_frob_p2_c1);
  out = out__s;
  out[0 : 72] = __rp72_0;
  out__s = out;
  out = out__s;
  return out;
}


