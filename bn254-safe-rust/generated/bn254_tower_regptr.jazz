export fn bn254_final_exp_dsd(reg ptr u64[48] out, reg const ptr u64[48] f, reg const ptr u64[8] gamma1_p2, reg const ptr u64[8] gamma2_p2, reg const ptr u64[8] w_frob_p2_c1) -> reg ptr u64[48] {
