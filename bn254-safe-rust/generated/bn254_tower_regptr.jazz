  stack u64[8] w_frob_p2_c1;
  gamma1_p2[0:8] = bn254_load_gamma1_p2(gamma1_p2[0:8]);
  gamma2_p2[0:8] = bn254_load_gamma2_p2(gamma2_p2[0:8]);
  w_frob_p2_c1[0:8] = bn254_load_w_frob_p2_c1(w_frob_p2_c1[0:8]);
  tmp[0:48] = bn254_miller_loop_optimal(tmp[0:48], p_x[0:4], p_y[0:4], q_x[0:8], q_y[0:8]);
  out[0:48] = bn254_final_exp_dsd(out[0:48], tmp[0:48], gamma1_p2[0:8], gamma2_p2[0:8], w_frob_p2_c1[0:8]);
  return out;
}
