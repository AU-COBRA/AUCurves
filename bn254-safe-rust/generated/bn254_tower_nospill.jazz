export fn bn254_Fp2_mul_xi(reg u64 out, reg u64 x) {
  reg u64 __wtmp__;
  reg u64 __mulx_tmp__;
  stack u64[4] tmp_a9;
  stack u64[4] tmp_b9;
  bn254_add(tmp_a9, x, x);
