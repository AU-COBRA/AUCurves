export fn bn254_pairing_dsd(reg u64 out, reg u64 p_x, reg u64 p_y, reg u64 q_x, reg u64 q_y) {
  reg u64 __wtmp__;
  reg u64 __mulx_tmp__;
  stack u64[48] tmp;
  stack u64[8] gamma1_p2;
  stack u64[8] gamma2_p2;
  stack u64[8] w_frob_p2_c1;
  bn254_load_gamma1_p2(gamma1_p2);
  bn254_load_gamma2_p2(gamma2_p2);
  bn254_load_w_frob_p2_c1(w_frob_p2_c1);
  bn254_miller_loop(tmp, p_x, p_y, q_x, q_y);
  bn254_final_exp_dsd(out, tmp, gamma1_p2, gamma2_p2, w_frob_p2_c1);
}


