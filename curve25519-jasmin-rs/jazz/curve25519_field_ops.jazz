// Exported field operations for GF(2^255-19), 4x64-bit saturated representation.
// Extracted from libjade/formosa-25519 mulx variant for use with CryptOpt hybrid path.
//
// Verification: EasyCrypt (Jazzline CCS 2025) + jasminc (EasyCrypt-verified compiler)

// ================================================================
// Inline helpers (from formosa-25519 common/64/)
// ================================================================

// h = f + g mod (2^255 - 19)
inline fn __add4_rrs(reg u64[4] f, stack u64[4] g) -> reg u64[4]
{
  inline int i;
  reg bool cf;
  reg u64[4] h;
  reg u64 z;

  ?{}, z = #set0();
  h = #copy(f);

  cf, h[0] += g[0];
  for i=1 to 4
  { cf, h[i] += g[i] + cf; }

  _, z -= z - cf;
  z &= 38;

  cf, h[0] += z;
  for i=1 to 4
  { cf, h[i] += 0 + cf; }

  _, z -= z - cf;
  z &= 38;
  h[0] += z;

  return h;
}

// h = f - g mod (2^255 - 19)
inline fn __sub4_rrs(reg u64[4] f, stack u64[4] gs) -> reg u64[4]
{
  inline int i;
  reg bool cf;
  reg u64[4] h;
  reg u64 z;

  ?{}, z = #set0();
  h = #copy(f);

  cf, h[0] -= gs[0];
  for i=1 to 4
  { cf, h[i] -= gs[i] - cf; }

  _, z -= z - cf;
  z &= 38;

  cf, h[0] -= z;
  for i=1 to 4
  { cf, h[i] -= 0 - cf; }

  _, z -= z - cf;
  z &= 38;
  h[0] -= z;

  return h;
}

// h = f * a24 mod (2^255 - 19), where a24 = 121665
inline fn __mul4_a24_rs(stack u64[4] fs, inline u64 a24) -> reg u64[4]
{
  reg bool cf;
  reg u64[4] h;
  reg u64 c r0 lo;

  c = a24;

  (h[1], h[0]) = #MULX(c, fs[0]);
  (h[2], lo)   = #MULX(c, fs[1]);
  cf, h[1] += lo;
  (h[3], lo)   = #MULX(c, fs[2]);
  cf, h[2] += lo + cf;
  (r0,   lo)   = #MULX(c, fs[3]);
  cf, h[3] += lo + cf;
     _, r0 += 0 + cf;

  _, _, _, _, _, r0 = #IMULri (r0, 38);

  cf, h[0] += r0;
  cf, h[1] += 0 + cf;
  cf, h[2] += 0 + cf;
  cf, h[3] += 0 + cf;

  _, c -= c - cf;
  c &= 38;
  h[0] += c;

  return h;
}

// Canonical encoding: reduce mod 2^255 - 19
inline fn __tobytes4(reg u64[4] f) -> reg u64[4]
{
  reg bool cf;
  reg u64 t;

  t = #LEA(f[3] + f[3]);
  ?{}, f[3] = #SAR(f[3], 63);
  t >>= 1;
  f[3] &= 19;
  f[3] += 19;

  cf, f[0] += f[3];
  cf, f[1] += 0 + cf;
  cf, f[2] += 0 + cf;
   _, t    += 0 + cf;

  f[3] = #LEA(t + t);
  ?{}, t = #SAR(t, 63);
  f[3] >>= 1;
  t = !t;
  t &= 19;

  cf, f[0] -= t;
  cf, f[1] -= 0 - cf;
  cf, f[2] -= 0 - cf;
   _, f[3] -= 0 - cf;

  return f;
}

// Constant-time conditional swap
inline fn __cswap4_ssss(
  stack u64[4] xs,
  stack u64[4] ys,
  reg   u64    swap)
  ->
  stack u64[4],
  stack u64[4]
{
  inline int i;
  reg u64[4] x y;
  reg u64 t mask;

  x = #copy(xs);
  mask = 0;
  mask -= swap;

  for i=0 to 4
  {
    y[i] = ys[i];
    t  = x[i];
    t ^= y[i];
    t &= mask;
    x[i] ^= t;
    y[i] ^= t;
    ys[i] = y[i];
  }

  xs = #copy(x);
  return xs, ys;
}

// ================================================================
// Export wrappers (System V ABI: rdi=out, rsi=a, rdx=b)
// ================================================================

// out = a + b mod p
export fn curve25519_add(
  reg u64 out_ptr,
  reg u64 a_ptr,
  reg u64 b_ptr)
{
  inline int i;
  stack u64[4] bs;
  reg u64[4] a h;

  for i=0 to 4 { a[i] = [a_ptr + 8*i]; }
  for i=0 to 4 { bs[i] = [b_ptr + 8*i]; }

  h = __add4_rrs(a, bs);

  for i=0 to 4 { [out_ptr + 8*i] = h[i]; }
}

// out = a - b mod p
export fn curve25519_sub(
  reg u64 out_ptr,
  reg u64 a_ptr,
  reg u64 b_ptr)
{
  inline int i;
  stack u64[4] bs;
  reg u64[4] a h;

  for i=0 to 4 { a[i] = [a_ptr + 8*i]; }
  for i=0 to 4 { bs[i] = [b_ptr + 8*i]; }

  h = __sub4_rrs(a, bs);

  for i=0 to 4 { [out_ptr + 8*i] = h[i]; }
}

// out = a * 121665 mod p  (Montgomery ladder constant a24)
export fn curve25519_mul_a24(
  reg u64 out_ptr,
  reg u64 a_ptr)
{
  inline int i;
  stack u64[4] as;
  reg u64[4] h;

  for i=0 to 4 { as[i] = [a_ptr + 8*i]; }

  h = __mul4_a24_rs(as, 121665);

  for i=0 to 4 { [out_ptr + 8*i] = h[i]; }
}

// out = tobytes(a)  (canonical reduction mod 2^255-19)
export fn curve25519_tobytes(
  reg u64 out_ptr,
  reg u64 a_ptr)
{
  inline int i;
  reg u64[4] f;

  for i=0 to 4 { f[i] = [a_ptr + 8*i]; }

  f = __tobytes4(f);

  for i=0 to 4 { [out_ptr + 8*i] = f[i]; }
}

// Constant-time swap: if swap != 0, exchange *a and *b
export fn curve25519_cswap(
  reg u64 a_ptr,
  reg u64 b_ptr,
  reg u64 swap)
{
  inline int i;
  stack u64[4] as bs;
  reg u64[4] x y;
  reg u64 t mask;

  for i=0 to 4 { as[i] = [a_ptr + 8*i]; }
  for i=0 to 4 { bs[i] = [b_ptr + 8*i]; }

  as, bs = __cswap4_ssss(as, bs, swap);

  x = #copy(as);
  y = #copy(bs);
  for i=0 to 4 { [a_ptr + 8*i] = x[i]; }
  for i=0 to 4 { [b_ptr + 8*i] = y[i]; }
}
