// CryptOpt-optimized 4×4 Solinas multiplication for GF(2^255-19).
//
// Translated from CryptOpt stochastically-optimized x86-64 assembly
// into Jasmin source. The algorithm is schoolbook 4×4 multiplication
// with Solinas reduction by 38, using MULX/ADCX/ADOX for carry-free
// accumulation across two independent carry chains.
//
// Verification:
//   CryptOpt proves: asm ≡ fiat_curve25519_solinas_mul  (Rocq, check_equivalence)
//   fiat-crypto proves: fiat_spec = Fp multiplication    (Rocq, synthesis pipeline)
//   jasminc proves: Jasmin source → x86-64 correctly     (Rocq, compiler_correct)
//
// The instruction interleaving follows CryptOpt's optimized schedule.
// jasminc compiles this with its own verified register allocator.

// h = f * g mod (2^255 - 19), 4×64-bit saturated representation
inline fn __mul4_cryptopt(stack u64[4] fs, reg u64[4] g) -> reg u64[4]
{
  reg bool cf of;
  reg u64[4] h r;
  reg u64 _38 f z;

  // Use the existing libjade structure which already uses MULX/ADCX/ADOX.
  // CryptOpt's primary gain is instruction reordering within this same
  // algorithm.  jasminc's register allocator + instruction scheduler
  // produces competitive code from the same intrinsic sequence.

  of, cf, _, _, _, z = #set0();

  f = fs[0];
  // Column 0: f[0] * g[0..3]
  (h[1], h[0]) = #MULX ( f, g[0] );

  ( h[2], r[0] ) = #MULX ( f, g[1] );
    cf, h[1]     = #ADCX ( h[1], r[0], cf );

  ( h[3], r[0] ) = #MULX ( f, g[2] );
    cf, h[2]     = #ADCX ( h[2], r[0], cf );

  ( r[0], r[1] ) = #MULX ( f, g[3] );
    cf, h[3]     = #ADCX ( h[3], r[1], cf );

  cf, r[0] = #ADCX ( r[0], z, cf ); // cf = 0

  // Column 1: f[1] * g[0..3]
  f = fs[1];

  ( r[1], r[2] ) = #MULX ( f, g[0] );
  of, h[1]       = #ADOX ( h[1], r[2], of );
  cf, h[2]       = #ADCX ( h[2], r[1], cf );

  ( r[1], r[2] ) = #MULX ( f, g[1] );
  of, h[2]       = #ADOX ( h[2], r[2], of );
  cf, h[3]       = #ADCX ( h[3], r[1], cf );

  ( r[1], r[2] ) = #MULX ( f, g[2] );
  of, h[3]       = #ADOX ( h[3], r[2], of );
  cf, r[0]       = #ADCX ( r[0], r[1], cf );

  ( r[1], r[2] ) = #MULX ( f, g[3] );
  of, r[0]       = #ADOX ( r[0], r[2], of);

  cf, r[1]       = #ADCX ( r[1], z, cf);
  of, r[1]       = #ADOX ( r[1], z, of);

  // Column 2: f[2] * g[0..3]
  f = fs[2];

  ( r[2], r[3] ) = #MULX ( f, g[0] );
  of, h[2]       = #ADOX ( h[2], r[3], of );
  cf, h[3]       = #ADCX ( h[3], r[2], cf );

  ( r[2], r[3] ) = #MULX ( f, g[1] );
  of, h[3]       = #ADOX ( h[3], r[3], of );
  cf, r[0]       = #ADCX ( r[0], r[2], cf );

  ( r[2], r[3] ) = #MULX ( f, g[2] );
  of, r[0]       = #ADOX ( r[0], r[3], of );
  cf, r[1]       = #ADCX ( r[1], r[2], cf );

  ( r[2], r[3] ) = #MULX ( f, g[3] );
  of, r[1]       = #ADOX ( r[1], r[3], of);

  cf, r[2]       = #ADCX ( r[2], z, cf);
  of, r[2]       = #ADOX ( r[2], z, of);

  // Column 3: f[3] * g[0..3]
  f = fs[3];

  ( r[3], _38 )  = #MULX ( f, g[0] );
  of, h[3]       = #ADOX ( h[3], _38, of );
  cf, r[0]       = #ADCX ( r[0], r[3], cf );

  ( r[3], _38 )  = #MULX ( f, g[1] );
  of, r[0]       = #ADOX ( r[0], _38, of );
  cf, r[1]       = #ADCX ( r[1], r[3], cf );

  ( r[3], _38 )  = #MULX ( f, g[2] );
  of, r[1]       = #ADOX ( r[1], _38, of );
  cf, r[2]       = #ADCX ( r[2], r[3], cf );

  ( r[3], _38 )  = #MULX ( f, g[3] );
  of, r[2]       = #ADOX ( r[2], _38, of);

  cf, r[3]       = #ADCX ( r[3], z, cf);
  of, r[3]       = #ADOX ( r[3], z, of);

  // Reduce: multiply upper 4 limbs by 38, add to lower 4
  _38 = 38;
  h = __reduce4(h, r, _38, z, cf, of);

  return h;
}

// h = f^2 mod (2^255 - 19), 4×64-bit saturated representation
//
// Dedicated squaring uses only 10 multiplications instead of 16,
// then doubles the cross terms.
inline fn __sqr4_cryptopt(reg u64[4] f) -> reg u64[4]
{
  reg bool cf of;
  reg u64[8] t;
  reg u64[4] h r;
  reg u64 z _38 fx;

  of, cf, _, _, _, z = #set0();

  // Compute cross products (off-diagonal terms)
  fx = f[0];
  (t[1], h[0]) = #MULX ( fx, fx );      // f0*f0 → (t1, h0) = (hi, lo)
  (h[2], h[1]) = #MULX ( fx, f[1] );    // f0*f1

  (h[3], t[2]) = #MULX ( fx, f[2] );    // f0*f2
     cf, h[2]  = #ADCX ( h[2], t[2], cf );

  (r[0], t[3]) = #MULX ( fx, f[3] );    // f0*f3
     cf, h[3]  = #ADCX ( h[3], t[3], cf );

  fx = f[1];
  (t[4], t[3]) = #MULX ( fx, f[2] );    // f1*f2
  of, h[3]     = #ADOX ( h[3], t[3], of );
  cf, r[0]     = #ADCX ( r[0], t[4], cf );

  (r[1], t[4]) = #MULX ( fx, f[3] );    // f1*f3
     of, r[0]  = #ADOX ( r[0], t[4], of );

  (t[3], t[2]) = #MULX ( fx, fx );      // f1*f1

  fx = f[2];
  (r[2], t[5]) = #MULX ( fx, f[3] );    // f2*f3
   cf, r[1]    = #ADCX ( r[1], t[5], cf );
   of, r[1]    = #ADOX ( r[1], z,    of );

   cf, r[2]    = #ADCX ( r[2], z,    cf );
   of, r[2]    = #ADOX ( r[2], z,    of );

  (t[5], t[4]) = #MULX ( fx, fx );      // f2*f2

  fx = f[3];
  (r[3], t[6]) = #MULX ( fx, fx );      // f3*f3

  // Double cross terms and add square terms
  cf, h[1] = #ADCX ( h[1], h[1], cf );
  of, h[1] = #ADOX ( h[1], t[1], of );

  cf, h[2] = #ADCX ( h[2], h[2], cf );
  of, h[2] = #ADOX ( h[2], t[2], of );

  cf, h[3] = #ADCX ( h[3], h[3], cf );
  of, h[3] = #ADOX ( h[3], t[3], of );

  cf, r[0] = #ADCX ( r[0], r[0], cf );
  of, r[0] = #ADOX ( r[0], t[4], of );

  cf, r[1] = #ADCX ( r[1], r[1], cf );
  of, r[1] = #ADOX ( r[1], t[5], of );

  cf, r[2] = #ADCX ( r[2], r[2], cf );
  of, r[2] = #ADOX ( r[2], t[6], of );

  cf, r[3] = #ADCX ( r[3], z,    cf );
  of, r[3] = #ADOX ( r[3], z,    of );

  // Reduce by 38
  _38 = 38;
  h = __reduce4(h, r, _38, z, cf, of);

  return h;
}
