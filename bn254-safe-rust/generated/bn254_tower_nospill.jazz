  bn254_Fp2_sub(t, t, a2b2);
  bn254_Fp2_mul_xi(t, t);
  bn254_Fp2_add(out, a0b0, t);
  bn254_Fp2_add(t, allocx, (allocx + 64));
  bn254_Fp2_add(u, allocy, (allocy + 64));
  bn254_Fp2_mul(t, t, u);
  bn254_Fp2_sub(t, t, a0b0);
  bn254_Fp2_sub(t, t, a1b1);
  bn254_Fp2_mul_xi(u, a2b2);
  bn254_Fp2_add((out + 64), t, u);
  bn254_Fp2_add(t, allocx, (allocx + 128));
  bn254_Fp2_add(u, allocy, (allocy + 128));
  bn254_Fp2_mul(t, t, u);
  bn254_Fp2_sub(t, t, a0b0);
  bn254_Fp2_sub(t, t, a2b2);
  bn254_Fp2_add((out + 128), t, a1b1);
}


