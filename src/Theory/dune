(include_subdirs qualified)

(coq.theory
 (name Theory)
 (mode vo)
 ; -native-compiler off: Theory has no native_compute calls — skip the
 ;   on-demand ocamlopt cascade triggered by fiat-crypto/Rewriter deps.
 ; -time: per-sentence timing in build output, negligible overhead,
 ;   makes slow sentences immediately visible without re-runs.
 ; Bedrock/Curve/*_prime_certif.v keep native (use native_cast_no_check).
 (flags -native-compiler off -time -profile-ltac -profile-ltac-cutoff 1)
 (theories Stdlib Crypto Coqprime))
