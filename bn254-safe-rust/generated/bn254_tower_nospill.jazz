  bn254_Fp2_add(t2, t2, t3);
  bn254_Fp2_mul_xi(t2, t2);
  bn254_Fp2_add(t1, t1, t2);
  bn254_Fp2_inv(t1, t1);
  bn254_Fp2_mul(out, vA, t1);
  bn254_Fp2_mul((out + 64), vB, t1);
  bn254_Fp2_mul((out + 128), vC, t1);
