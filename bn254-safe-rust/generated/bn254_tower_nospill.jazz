  bn254_add(tmp_a9, tmp_a9, tmp_a9);
  bn254_add(tmp_a9, tmp_a9, x);
  bn254_add(tmp_b9, (x + 32), (x + 32));
  bn254_add(tmp_b9, tmp_b9, tmp_b9);
  bn254_add(tmp_b9, tmp_b9, tmp_b9);
  bn254_add(tmp_b9, tmp_b9, (x + 32));
  bn254_sub(out, tmp_a9, (x + 32));
  bn254_add((out + 32), x, tmp_b9);
}


