  stack u64[12] w_frob_p2_c1;
  gamma1_p2 = bls12_load_gamma1_p2(gamma1_p2);
  gamma2_p2 = bls12_load_gamma2_p2(gamma2_p2);
  w_frob_p2_c1 = bls12_load_w_frob_p2_c1(w_frob_p2_c1);
  p_x = p_x__s;
  p_y = p_y__s;
  q_x = q_x__s;
  q_y = q_y__s;
  tmp = bls12_miller_loop(tmp, p_x, p_y, q_x, q_y);
  out = out__s;
  out = bls12_final_exp(out, tmp, gamma1_p2, gamma2_p2, w_frob_p2_c1);
  out__s = out;
  out = out__s;
  return out;
}


export fn jasmin_bls12_add(reg ptr u64[6] out0, reg const ptr u64[6] in0, reg const ptr u64[6] in1) -> reg ptr u64[6] {
  out0 = bls12_add(out0, in0, in1);
  return out0;
}


